{
  "name": "cartoon-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local studio for original hand-drawn cartoons, powered by p5.brush.",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "render": "node --env-file-if-exists=.env --import tsx scripts/render.ts",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "p5.brush": "3.0.0",
    "playwright": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
