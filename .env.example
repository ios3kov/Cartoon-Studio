# Optional. The editor and video export do not need an AI key.
# Copy this file to .env. Never commit .env or keys.

# An OpenAI-compatible Chat Completions provider with JSON-object support.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional speech generation. Select a model supported by your provider.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=
# Explicitly reuse AI_API_KEY for speech if desired:
TTS_USE_AI_KEY=0

# Optional paths when executables are not in their usual locations.
# CHROME_PATH=/absolute/path/to/chrome
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Use software WebGL in headless Linux environments without a GPU.
# STUDIO_SOFTWARE_GL=1

# The server always listens on loopback. Public hosting needs a separate design.
# PORT=4173
